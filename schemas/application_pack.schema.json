{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project2job.dev/schemas/application-pack/2.0.0",
  "title": "ApplicationAndInterviewPack",
  "description": "The company-specific output produced after one selected project's evidence has been verified. Project facts here are verified evidence; company and interview material is research carried with its own source status and is never promoted to project evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role_profile_ref",
    "project_version",
    "run_type",
    "intent",
    "role_fit_map",
    "project_highlights",
    "resume_bullets",
    "interview_pack",
    "next_build",
    "correction_prompt",
    "warnings"
  ],
  "allOf": [
    {
      "description": "A JD-backed run must carry interview context. PROJECT_COMPASS has no JD and therefore no company, and must not invent one to satisfy this schema.",
      "if": {
        "properties": {
          "intent": {
            "enum": [
              "application_pack",
              "update"
            ]
          }
        },
        "required": [
          "intent"
        ]
      },
      "then": {
        "required": [
          "interview_context"
        ]
      }
    }
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "interview_context": {
      "$ref": "https://project2job.dev/schemas/interview-context/1.0.0"
    },
    "role_profile_ref": {
      "$ref": "#/$defs/roleProfileRef"
    },
    "project_version": {
      "type": "string"
    },
    "run_type": {
      "enum": [
        "skill_initial",
        "agent_initial",
        "agent_update"
      ]
    },
    "intent": {
      "enum": [
        "application_pack",
        "project_compass",
        "update"
      ]
    },
    "role_fit_map": {
      "type": "array",
      "minItems": 5,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/roleFitItem"
      }
    },
    "project_highlights": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/groundedText"
      }
    },
    "resume_bullets": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/resumeBullet"
      }
    },
    "interview_pack": {
      "$ref": "#/$defs/interviewPack"
    },
    "next_build": {
      "$ref": "#/$defs/nextBuild"
    },
    "correction_prompt": {
      "type": "string",
      "minLength": 1
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "change_summary": {
      "type": "object"
    },
    "telemetry": {
      "type": "object"
    }
  },
  "$defs": {
    "roleProfileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_id",
        "version"
      ],
      "properties": {
        "role_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "location"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "location": {
          "type": "string"
        }
      }
    },
    "groundedText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "source_refs",
        "boundary"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "boundary": {
          "type": "string"
        }
      }
    },
    "roleFitItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_requirement_id",
        "capability_id",
        "relevance",
        "status",
        "source_refs",
        "boundary",
        "interview_risk"
      ],
      "properties": {
        "role_requirement_id": {
          "type": "string"
        },
        "capability_id": {
          "type": "string"
        },
        "relevance": {
          "enum": [
            "required",
            "important",
            "supporting"
          ]
        },
        "status": {
          "enum": [
            "supported",
            "partially_supported",
            "inferred",
            "not_found",
            "conflicting",
            "needs_confirmation"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "boundary": {
          "type": "string"
        },
        "interview_risk": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "description": "An established status must cite at least one source.",
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "supported",
                  "partially_supported"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "source_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "resumeBullet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "source_refs",
        "risk",
        "missing_to_strengthen"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "risk": {
          "type": "string"
        },
        "missing_to_strengthen": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "interviewPack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intro_30_seconds",
        "intro_source_refs",
        "company_track_brief",
        "interview_loop_hypothesis",
        "priority_questions",
        "answer_drafts",
        "questions_to_ask_interviewer",
        "mock_interview_round",
        "unsupported_areas"
      ],
      "properties": {
        "intro_30_seconds": {
          "type": "string"
        },
        "intro_source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "company_track_brief": {
          "type": "string",
          "minLength": 1,
          "description": "Short brief on the company and track drawn from interview_context. Must not assert project facts. In a PROJECT_COMPASS run with no JD, state that no company context exists rather than inventing one."
        },
        "interview_loop_hypothesis": {
          "type": "array",
          "minItems": 1,
          "description": "A hypothesis, not a schedule. Every stage carries its own source status.",
          "items": {
            "$ref": "#/$defs/loopStage"
          }
        },
        "priority_questions": {
          "type": "array",
          "minItems": 5,
          "maxItems": 8,
          "items": {
            "$ref": "https://project2job.dev/schemas/interview-context/1.0.0#/$defs/interviewQuestion"
          }
        },
        "answer_drafts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/answerDraft"
          }
        },
        "questions_to_ask_interviewer": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "mock_interview_round": {
          "$ref": "#/$defs/mockInterviewRound"
        },
        "unsupported_areas": {
          "type": "array",
          "description": "Claims the project evidence does not support or the user has not confirmed.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "loopStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "expected_focus",
        "source_status"
      ],
      "properties": {
        "stage": {
          "enum": [
            "recruiter_screen",
            "hiring_manager",
            "technical_or_case",
            "cross_functional",
            "final_or_bar_raiser",
            "unknown"
          ]
        },
        "expected_focus": {
          "type": "string",
          "minLength": 1
        },
        "source_status": {
          "$ref": "https://project2job.dev/schemas/interview-context/1.0.0#/$defs/sourceStatus"
        },
        "basis": {
          "type": "string",
          "description": "Which signal or requirement supports this stage."
        }
      }
    },
    "answerDraft": {
      "type": "object",
      "additionalProperties": false,
      "description": "question -> verified evidence -> answer ingredients -> grounded draft -> claim-safety review -> likely follow-ups.",
      "required": [
        "question_id",
        "question",
        "verified_evidence",
        "answer_ingredients",
        "grounded_draft",
        "claim_safety_review",
        "likely_followups",
        "emphasis"
      ],
      "properties": {
        "question_id": {
          "type": "string",
          "description": "Must match a question_id in priority_questions. JSON Schema cannot check this cross-reference; the WO-05 output validator does."
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "verified_evidence": {
          "type": "array",
          "minItems": 1,
          "description": "Only verified project evidence. Company research may shape emphasis but may never appear here.",
          "items": {
            "$ref": "#/$defs/verifiedFact"
          }
        },
        "answer_ingredients": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "grounded_draft": {
          "type": "string",
          "minLength": 1
        },
        "claim_safety_review": {
          "$ref": "#/$defs/claimSafetyReview"
        },
        "likely_followups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "emphasis": {
          "$ref": "#/$defs/emphasisProfile"
        }
      }
    },
    "verifiedFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "text",
        "status",
        "source_refs"
      ],
      "properties": {
        "fact_id": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "description": "Only established statuses may back an answer draft.",
          "enum": [
            "supported",
            "partially_supported"
          ]
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        }
      }
    },
    "claimSafetyReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exceeds_evidence",
        "checked_fact_ids"
      ],
      "properties": {
        "exceeds_evidence": {
          "const": false,
          "description": "A draft that exceeds its evidence must be narrowed or dropped, never shipped inside a pack."
        },
        "checked_fact_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "narrowed_from": {
          "type": "string",
          "description": "The stronger wording that was rejected, when a draft was narrowed."
        }
      }
    },
    "emphasisProfile": {
      "type": "object",
      "additionalProperties": false,
      "description": "Company signals may reorder or reweight the same facts. fact_ids is the invariant: it must not change when emphasis changes. Invariance is across runs, so no schema can check it; eval case D2-010 does.",
      "required": [
        "fact_ids",
        "emphasis_signal_ids"
      ],
      "properties": {
        "fact_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "emphasis_signal_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "mockInterviewRound": {
      "type": "object",
      "additionalProperties": false,
      "description": "A specification for one round. Day 2 defines the contract only; no mock-interview runtime exists.",
      "required": [
        "round_format",
        "question_ids",
        "time_box_minutes",
        "scoring_dimensions",
        "stop_condition"
      ],
      "properties": {
        "round_format": {
          "enum": [
            "hiring_manager_project_deep_dive",
            "technical_or_case",
            "cross_functional"
          ]
        },
        "question_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "string"
          }
        },
        "time_box_minutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 45
        },
        "scoring_dimensions": {
          "type": "array",
          "minItems": 1,
          "description": "Evidence-based dimensions only. Personality or culture-fit scoring is out of scope.",
          "items": {
            "enum": [
              "evidence_grounding",
              "claim_boundary_discipline",
              "role_relevance",
              "specificity",
              "followup_recovery"
            ]
          }
        },
        "stop_condition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nextBuild": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gap",
        "why_now",
        "steps",
        "acceptance_criteria",
        "expected_evidence",
        "output_dependency",
        "estimated_effort_band",
        "interview_question_unlocked"
      ],
      "properties": {
        "gap": {
          "type": "string"
        },
        "why_now": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "expected_evidence": {
          "type": "string"
        },
        "output_dependency": {
          "type": "string"
        },
        "estimated_effort_band": {
          "enum": [
            "small",
            "medium",
            "large"
          ]
        },
        "interview_question_unlocked": {
          "type": "string"
        }
      }
    }
  }
}
