{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project2job.dev/schemas/agent-state/1.0.0",
  "title": "Project2Job Agent State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_version",
    "jd_version",
    "artifacts",
    "evidence",
    "claims",
    "outputs",
    "dependencies",
    "confirmed_facts",
    "unresolved_questions"
  ],
  "properties": {
    "project_version": {"type": "string"},
    "jd_version": {"type": "string"},
    "project_label": {"type": "string"},
    "jd_label": {"type": "string"},
    "artifacts": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "evidence": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/evidenceItem"}
    },
    "claims": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/claim"}
    },
    "outputs": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/output"}
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {"type": "string"}
      }
    },
    "confirmed_facts": {"type": "object"},
    "unresolved_questions": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "evidenceItem": {
      "type": "object",
      "required": ["source", "summary"],
      "properties": {
        "source": {"type": "string"},
        "location": {"type": "string"},
        "summary": {"type": "string"},
        "artifact_type": {
          "enum": [
            "controlled_summary_existing_fact",
            "simulated_proposed_artifact",
            "executed_new_result",
            "unclassified_changed_evidence"
          ]
        }
      }
    },
    "claim": {
      "type": "object",
      "required": ["status", "attribution_scope"],
      "properties": {
        "status": {
          "enum": [
            "supported",
            "partially_supported",
            "inferred",
            "not_found",
            "conflicting",
            "needs_confirmation"
          ]
        },
        "attribution_scope": {
          "enum": [
            "directly_owned",
            "ai_assisted",
            "collaborator_owned",
            "unresolved"
          ]
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["kind", "depends_on"],
      "properties": {
        "kind": {
          "enum": [
            "score",
            "jd_match",
            "story",
            "route",
            "resume_bullet",
            "answer",
            "company_intelligence",
            "question",
            "upgrade_plan",
            "mock",
            "verdict"
          ]
        },
        "depends_on": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "label": {"type": "string"},
        "value": {"type": "integer", "minimum": 1, "maximum": 5},
        "match": {"enum": ["EXACT MATCH", "TRANSFERABLE", "GAP"]},
        "content": {"type": "string", "maxLength": 4000},
        "before": {},
        "why": {"type": "string"},
        "exported": {"type": "boolean"}
      }
    }
  }
}
