{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApplicationPack",
  "type": "object",
  "required": [
    "run_type",
    "intent",
    "role_fit_map",
    "project_highlights",
    "resume_bullets",
    "interview_pack",
    "next_build",
    "warnings"
  ],
  "properties": {
    "run_type": {
      "enum": [
        "skill_initial",
        "agent_initial",
        "agent_update"
      ]
    },
    "intent": {
      "enum": [
        "application_pack",
        "project_compass",
        "update"
      ]
    },
    "role_fit_map": {
      "type": "array",
      "minItems": 3
    },
    "project_highlights": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5
    },
    "resume_bullets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "text",
          "source_refs",
          "risk"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risk": {
            "type": "string"
          },
          "missing_to_strengthen": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "interview_pack": {
      "type": "object",
      "required": [
        "intro_30_seconds",
        "questions"
      ]
    },
    "next_build": {
      "type": "object",
      "required": [
        "gap",
        "why_now",
        "steps",
        "acceptance_criteria",
        "expected_evidence"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "change_summary": {
      "type": "object"
    },
    "telemetry": {
      "type": "object"
    }
  }
}
